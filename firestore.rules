rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules.
// Not deployed automatically — this repo has no Firebase CLI/project link configured.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Any signed-in user can read profiles (needed to look up a referral code owner).
      allow read: if request.auth != null;

      // A user can only create their own profile document.
      allow create: if request.auth != null && request.auth.uid == userId;

      // A user can update their own profile freely. Anyone else may ONLY increment
      // inviteCount by exactly 1 — this is what lets an invitee's sign-up bump the
      // inviter's counter without a paid Cloud Function.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCount']) &&
          request.resource.data.inviteCount == resource.data.inviteCount + 1
        )
      );

      allow delete: if false;
    }
  }
}
