rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules.
// Not deployed automatically — this repo has no Firebase CLI/project link configured.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Any signed-in user can read profiles (needed to look up a referral code owner).
      allow read: if request.auth != null;

      // A user can only create their own profile document.
      allow create: if request.auth != null && request.auth.uid == userId;

      // A user can update their own profile freely. Anyone else may ONLY increment
      // inviteCount by exactly 1 — this is what lets an invitee's sign-up bump the
      // inviter's counter without a paid Cloud Function.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCount']) &&
          request.resource.data.inviteCount == resource.data.inviteCount + 1
        )
      );

      allow delete: if false;
    }

    // Prayer/saint content + its version markers. Public read (it's not sensitive — the app
    // itself ships the same content as a bundled JSON fallback). No client write path at all:
    // these are only ever written by scripts/sync-content-to-firestore.js authenticated via
    // gcloud IAM (a service account with roles/datastore.user), which bypasses these rules
    // entirely — that's intentional, not a hole to close.
    match /prayers/{prayerId} {
      allow read: if true;
      allow write: if false;
    }
    match /saints/{saintId} {
      allow read: if true;
      allow write: if false;
    }
    // Community prayer intentions. amens/{uid} and reports/{uid} are one-per-user guard docs:
    // a counter on the post may only go up by exactly 1, and only in the same batch that
    // creates the caller's own guard doc (so nobody can amen/report twice or inflate counts).
    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt', 'amenCount', 'reportCount'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.amenCount == 0
        && request.resource.data.reportCount == 0;

      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amenCount']) &&
          request.resource.data.amenCount == resource.data.amenCount + 1 &&
          !exists(/databases/$(database)/documents/posts/$(postId)/amens/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/posts/$(postId)/amens/$(request.auth.uid))
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
          request.resource.data.reportCount == resource.data.reportCount + 1 &&
          !exists(/databases/$(database)/documents/posts/$(postId)/reports/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/posts/$(postId)/reports/$(request.auth.uid))
        )
      );

      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      match /amens/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
      }
      match /reports/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /content_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
