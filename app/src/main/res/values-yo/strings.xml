    <string name="tradition_protestant_desc">Ìwé Mímọ́, àwọn Orin Dáfídì, àdúrà àwọn Olùtúnṣe àti ìfọkànsìn ojoojúmọ́</string>
    <string name="tradition_anglican">Áńgílíkánì</string>
