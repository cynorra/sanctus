    <string name="onboarding_title_1">Káàbọ̀ sí Sanctus</string>
    <string name="onboarding_desc_1">Alábàákẹ́gbẹ́ mímọ́ rẹ fún Ìjọsìn Wákàtí, Rosary, Àwọn Ènìyàn Mímọ́, àti Kalẹndà Ìjọsìn.</string>
    <string name="onboarding_title_2">Àwọn Wákàtí Ìjọsìn</string>
    <string name="onboarding_desc_2">Gba ìrántí pẹ̀lẹ́ fún gbogbo wákàtí ìjọsìn mẹ́fà — Ìyìn Òwúrọ̀, Wákàtí Kẹta, Àdúrà Ọ̀sán, Ọ̀sán Gbàngbà, Àdúrà Alẹ́, àti Àdúrà Òru.</string>
    <string name="onboarding_title_3">Rosary Mímọ́</string>
    <string name="onboarding_desc_3">Rosary tí a ń darí pẹ̀lú yíyan awò-awò-ìjìnlẹ̀ láìfọwọ́kàn gẹ́gẹ́ bí ọjọ́ ọ̀sẹ̀.</string>
    <string name="onboarding_title_4">Àwọn Ènìyàn Mímọ́ àti Kalẹndà</string>
    <string name="onboarding_desc_4">Ṣàwárí Ènìyàn Mímọ́ Ọjọ́ Yìí kí o sì wo gbogbo kalẹndà ìjọsìn — àwọn àjọdún, ọlá ńlá, àti àwọn àkókò.</string>
