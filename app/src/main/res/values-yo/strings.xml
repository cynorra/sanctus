    <string name="onboarding_welcome_tagline">Ibi àlàáfíà láti gbàdúrà, lójoojúmọ́.</string>
    <string name="onboarding_welcome_body">Àwọn àdúrà ojoojúmọ́, Roṣári, àwọn ènìyàn mímọ́ àti àwọn wákàtí ọjọ́, tí a ṣe ní ìbámu pẹ̀lú àṣà rẹ.</string>
    <string name="onboarding_tradition_title">Àṣà wo ni tìrẹ?</string>
    <string name="onboarding_tradition_subtitle">À ń ṣe àtúnṣe àwọn àdúrà, àwọn ènìyàn mímọ́ àti kàlẹ́ńdà sí i. O lè yí i padà nígbàkúùgbà nínú Ètò.</string>
    <string name="onboarding_rhythm_title">Ìrìn ojoojúmọ́ tó rọ̀</string>
    <string name="onboarding_rhythm_body">Àwọn ìrántí rírọ̀ ní àwọn wákàtí àdúrà: òwúrọ̀, ọ̀sán, ìrọ̀lẹ́ àti alẹ́. Pa wọ́n nígbàkúùgbà tí o bá fẹ́.</string>
    <string name="tradition_catholic">Kátólíìkì</string>
    <string name="tradition_catholic_desc">Roṣári, àwọn ènìyàn mímọ́, nòfẹ́ná àti Ìjọsìn Àwọn Wákàtí</string>
    <string name="tradition_orthodox">Ọ́tọ́dọ́ksì</string>
    <string name="tradition_orthodox_desc">Àdúrà Jésù, Trisagion, àwọn Baba Ìjọ àti àwọn orin àtijọ́</string>
