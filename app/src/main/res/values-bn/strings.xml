    <string name="onboarding_title_1">Sanctus-এ স্বাগতম</string>
    <string name="onboarding_desc_1">প্রার্থনা প্রহর, জপমালা, সাধুগণ এবং গির্জাবর্ষের পঞ্জিকার জন্য আপনার পবিত্র সঙ্গী।</string>
    <string name="onboarding_title_2">প্রার্থনা প্রহর</string>
    <string name="onboarding_desc_2">ছয়টি প্রার্থনা প্রহরের জন্য কোমল স্মারক পান — প্রভাতী, তৃতীয় প্রহর, মধ্যাহ্ন, নবম প্রহর, সন্ধ্যা ও রাত্রি প্রার্থনা।</string>
    <string name="onboarding_title_3">পবিত্র জপমালা</string>
    <string name="onboarding_desc_3">সপ্তাহের দিন অনুযায়ী স্বয়ংক্রিয় রহস্য নির্বাচনসহ গাইডেড জপমালা।</string>
    <string name="onboarding_title_4">সাধুগণ ও পঞ্জিকা</string>
