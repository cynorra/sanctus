<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@android:color/transparent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:paddingHorizontal="8dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingTop="8dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="44dp"
            android:layout_height="44dp" android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/color_on_surface" android:contentDescription="@string/content_desc_back"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="24dp"
            android:paddingTop="8dp" android:paddingBottom="48dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/invite_title" android:fontFamily="@font/ebgaramond"
                android:textSize="28sp" android:textColor="@color/color_on_background"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/invite_subtitle"
                android:textSize="14sp" android:lineSpacingMultiplier="1.4"
                android:textColor="@color/color_text_secondary"/>

            <!-- Signed-out state -->
            <LinearLayout android:id="@+id/group_signed_out" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/sign_in_with_google"
                    app:backgroundTint="@color/color_accent"
                    android:textColor="@color/color_background"/>

                <TextView android:id="@+id/tv_sign_in_error" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textSize="12sp" android:textColor="@color/color_error"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Signed-in state -->
            <LinearLayout android:id="@+id/group_signed_in" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="28dp" android:visibility="gone">

                <TextView android:id="@+id/tv_display_name" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="18sp"
                    android:fontFamily="@font/ebgaramond" android:textColor="@color/color_on_background"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card_gold"
                    android:padding="20dp" android:layout_marginTop="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/your_invite_code" android:textSize="10sp"
                        android:letterSpacing="0.15" android:textAllCaps="true"
                        android:textColor="@color/color_accent"/>

                    <TextView android:id="@+id/tv_referral_code" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:fontFamily="@font/ebgaramond" android:textSize="30sp" android:letterSpacing="0.1"
                        android:textColor="@color/color_on_background"/>

                    <TextView android:id="@+id/tv_invite_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:textSize="13sp" android:textColor="@color/color_text_secondary"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_invite"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/share_invite_link"
                    app:backgroundTint="@color/color_accent"
                    android:textColor="@color/color_background"/>

                <TextView android:id="@+id/btn_sign_out" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:layout_gravity="center" android:padding="8dp"
                    android:text="@string/sign_out" android:textSize="13sp"
                    android:textColor="@color/color_text_secondary"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
