<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_hour_setting_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_background"
            android:textSize="13.5sp"
            android:fontFamily="@font/inter" />

        <TextView
            android:id="@+id/tv_hour_setting_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingVertical="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/ebgaramond"
            android:textStyle="italic"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_hour_setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@color/color_background"
        app:trackTint="@color/selector_switch_track"
        app:trackDecorationTint="@android:color/transparent" />
</LinearLayout>
