<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/color_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp"
        android:paddingTop="52dp" android:paddingBottom="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_saints" android:fontFamily="serif"
            android:textSize="28sp" android:textColor="@color/color_on_background"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_search_saints" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_gold" android:paddingHorizontal="16dp"
            android:hint="Search saints…" android:textSize="14sp"
            android:textColor="@color/color_on_surface"
            android:textColorHint="@color/color_text_secondary"
            android:inputType="text" android:imeOptions="actionSearch"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_saints" android:layout_width="match_parent"
        android:layout_height="match_parent" android:paddingTop="4dp"
        android:clipToPadding="false"/>
</LinearLayout>
