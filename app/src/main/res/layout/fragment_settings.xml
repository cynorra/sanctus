<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Sanctus.HeadlineLarge" />

        <!-- PERSONAL -->
        <TextView
            style="@style/Sanctus.SectionLabel"
            android:text="@string/settings_section_tradition" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card">

            <LinearLayout
                android:id="@+id/row_tradition"
                style="@style/Sanctus.SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Sanctus.SettingsRowTitle"
                        android:text="@string/settings_tradition_title" />

                    <TextView
                        style="@style/Sanctus.SettingsRowSubtitle"
                        android:text="@string/settings_tradition_subtitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_tradition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?attr/sanctusAccent"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:rotation="-90"
                    app:tint="@color/color_text_secondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/Sanctus.RowDivider" />

            <LinearLayout
                android:id="@+id/row_language"
                style="@style/Sanctus.SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Sanctus.SettingsRowTitle"
                        android:text="@string/prayer_language_label" />

                    <TextView
                        style="@style/Sanctus.SettingsRowSubtitle"
                        android:text="@string/languages_supported" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?attr/sanctusAccent"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:rotation="-90"
                    app:tint="@color/color_text_secondary"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- NOTIFICATIONS -->
        <TextView
            style="@style/Sanctus.SectionLabel"
            android:text="@string/settings_section_notifications" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card">

            <LinearLayout style="@style/Sanctus.SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Sanctus.SettingsRowTitle"
                        android:text="@string/notifications" />

                    <TextView
                        style="@style/Sanctus.SettingsRowSubtitle"
                        android:text="@string/notification_hours_summary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_hour_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/row_exact_alarm"
                style="@style/Sanctus.SettingsRow"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Sanctus.SettingsRowTitle"
                        android:text="@string/exact_alarm_title" />

                    <TextView
                        style="@style/Sanctus.SettingsRowSubtitle"
                        android:text="@string/exact_alarm_desc" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- COMMUNITY + ABOUT -->
        <TextView
            style="@style/Sanctus.SectionLabel"
            android:text="@string/about_section_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card">

            <LinearLayout
                android:id="@+id/row_invite"
                style="@style/Sanctus.SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Sanctus.SettingsRowTitle"
                        android:text="@string/invite_row_title" />

                    <TextView
                        style="@style/Sanctus.SettingsRowSubtitle"
                        android:text="@string/invite_row_subtitle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:rotation="-90"
                    app:tint="@color/color_text_secondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/Sanctus.RowDivider" />

            <LinearLayout
                android:id="@+id/row_about"
                style="@style/Sanctus.SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Sanctus.SettingsRowTitle"
                        android:text="@string/about_title" />

                    <TextView
                        style="@style/Sanctus.SettingsRowSubtitle"
                        android:text="@string/about_row_subtitle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:rotation="-90"
                    app:tint="@color/color_text_secondary"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
