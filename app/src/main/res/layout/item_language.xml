<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:paddingHorizontal="24dp"
    android:gravity="center_vertical" android:background="?attr/selectableItemBackground">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_lang_native" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textColor="@color/color_on_background"/>
        <TextView android:id="@+id/tv_lang_english" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/color_text_secondary"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_lang_pop" android:layout_width="40dp"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/color_text_secondary" android:gravity="end"/>

    <TextView android:id="@+id/tv_lang_check" android:layout_width="24dp"
        android:layout_height="wrap_content" android:text="✓"
        android:textSize="14sp" android:textColor="@color/color_accent"
        android:layout_marginStart="8dp" android:gravity="center"/>
</LinearLayout>
