<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp"
    android:gravity="center_vertical" android:background="?attr/selectableItemBackground">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_saint_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:fontFamily="serif"
            android:textSize="16sp" android:textColor="@color/color_on_background"/>
        <TextView android:id="@+id/tv_patron_of" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textSize="12sp" android:textColor="@color/color_text_secondary"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_feast_date" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/color_accent" android:layout_marginStart="8dp"/>
</LinearLayout>
