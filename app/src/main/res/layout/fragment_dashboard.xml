<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/color_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sanctus"
                    android:fontFamily="serif"
                    android:textSize="28sp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/color_on_background" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_liturgical_season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_gold_pill"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/color_background" />

            <ImageButton
                android:id="@+id/btn_open_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/color_text_secondary"
                android:contentDescription="@string/open_settings" />

        </LinearLayout>

        <!-- Streak -->
        <LinearLayout
            android:id="@+id/row_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flame"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="13sp"
                android:textColor="@color/color_accent" />

        </LinearLayout>

        <!-- Hero Card: Next Canonical Hour (tap header to expand today's schedule, tap footer to pray) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_next_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gold"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_next_hour_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/next_canonical_hour_label"
                            android:textSize="10sp"
                            android:letterSpacing="0.15"
                            android:textColor="@color/color_accent"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tv_next_hour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="serif"
                            android:textSize="26sp"
                            android:textColor="@color/color_on_background" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_expand_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/color_accent"
                        android:contentDescription="@null" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_hours_expand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/color_divider" />

                    <LinearLayout
                        android:id="@+id/list_hours_mini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/color_divider" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_begin_prayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_to_begin_prayer"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Canonical Hours Horizontal List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="24dp"
            android:text="@string/canonical_hours"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:textColor="@color/color_text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_prayer_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="20dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_anim_fall_down"
            android:orientation="horizontal" />


        <!-- Prayer of the Day -->
        <LinearLayout
            android:id="@+id/card_prayer_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_hero_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_of_day"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/color_accent" />

            <TextView
                android:id="@+id/tv_prayer_of_day_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:textSize="22sp"
                android:textColor="@color/color_on_background" />

            <TextView
                android:id="@+id/tv_prayer_of_day_excerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.5"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/color_on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="@string/read_more"
                    android:textSize="13sp"
                    android:textColor="@color/color_accent" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_share_prayer_of_day"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/color_accent"
                    android:contentDescription="@string/share_action" />
            </LinearLayout>
        </LinearLayout>

        <!-- Saint of the Day -->
        <LinearLayout
            android:id="@+id/card_saint_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_hero_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saint_of_day"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/color_accent" />

            <TextView
                android:id="@+id/tv_saint_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:textSize="22sp"
                android:textColor="@color/color_on_background" />

            <TextView
                android:id="@+id/tv_saint_feast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/color_gold_light" />

            <TextView
                android:id="@+id/tv_saint_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.5"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/color_on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="@string/read_more"
                    android:textSize="13sp"
                    android:textColor="@color/color_accent" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_share_saint_of_day"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/color_accent"
                    android:contentDescription="@string/share_action" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
