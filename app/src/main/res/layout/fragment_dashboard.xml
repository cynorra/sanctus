<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sanctus.Eyebrow"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sanctus.HeadlineLarge"
                    android:letterSpacing="0.03" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_liturgical_season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_gold_pill"
                android:textSize="10.5sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/color_background" />

            <ImageButton
                android:id="@+id/btn_open_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_glass_circle"
                app:tint="@color/color_on_surface"
                android:contentDescription="@string/open_settings" />
        </LinearLayout>

        <!-- Streak -->
        <LinearLayout
            android:id="@+id/row_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_chip_outline"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_flame"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="?attr/sanctusAccent" />
        </LinearLayout>

        <!-- Hero: next canonical hour (header expands today's schedule, footer starts praying) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_next_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gold">

                <View
                    android:id="@+id/hero_glow"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-60dp"
                    android:background="@drawable/bg_orb_gold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_next_hour_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="24dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/next_canonical_hour_label"
                                android:textAppearance="@style/TextAppearance.Sanctus.Eyebrow"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tv_next_hour"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ebgaramond"
                                android:textStyle="bold"
                                android:textSize="32sp"
                                android:textColor="@color/color_on_background" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_expand_chevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="?attr/sanctusAccent"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_hours_expand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/color_glass_stroke" />

                        <LinearLayout
                            android:id="@+id/list_hours_mini"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/color_glass_stroke" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_begin_prayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="22dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tap_to_begin_prayer"
                            android:textSize="14sp"
                            android:textColor="@color/color_on_surface" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_down"
                            android:rotation="-90"
                            app:tint="?attr/sanctusAccent"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick access -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_rosary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_glass_card">

                <ImageView
                    android:id="@+id/tile_rosary_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_rosary"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tile_rosary_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/nav_rosary"
                    android:textColor="@color/color_on_background"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_prayers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_glass_card">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_prayer"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/nav_prayers"
                    android:textColor="@color/color_on_background"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Canonical hours -->
        <TextView
            style="@style/Sanctus.SectionLabel"
            android:layout_marginStart="26dp"
            android:text="@string/canonical_hours"
            android:textAllCaps="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_prayer_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_anim_fall_down"
            android:orientation="horizontal" />

        <!-- Prayer of the day -->
        <LinearLayout
            android:id="@+id/card_prayer_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_hero_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_of_day"
                android:textAppearance="@style/TextAppearance.Sanctus.Eyebrow"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tv_prayer_of_day_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Sanctus.HeadlineMedium" />

            <TextView
                android:id="@+id/tv_prayer_of_day_excerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Sanctus.Prayer"
                android:textSize="19sp"
                android:maxLines="5"
                android:ellipsize="end"
                android:textColor="@color/color_on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="@string/read_more"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="?attr/sanctusAccent" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_share_prayer_of_day"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@string/share_action" />
            </LinearLayout>
        </LinearLayout>

        <!-- Saint of the day -->
        <LinearLayout
            android:id="@+id/card_saint_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_saint_initial"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:background="@drawable/bg_gold_circle"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:textColor="@color/color_background" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_saint_kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/saint_of_day"
                        android:textAppearance="@style/TextAppearance.Sanctus.Eyebrow"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tv_saint_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/ebgaramond"
                        android:textStyle="bold"
                        android:textSize="23sp"
                        android:textColor="@color/color_on_background" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_saint_feast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="12.5sp"
                android:textColor="?attr/sanctusAccentSoft" />

            <TextView
                android:id="@+id/tv_saint_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.4"
                android:textSize="15sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/color_on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="@string/read_more"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="?attr/sanctusAccent" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_share_saint_of_day"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@string/share_action" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
