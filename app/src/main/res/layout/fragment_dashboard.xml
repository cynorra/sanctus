<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/color_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sanctus"
                    android:fontFamily="serif"
                    android:textSize="28sp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/color_on_background" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_liturgical_season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_gold_pill"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/color_background" />

        </LinearLayout>

        <!-- Streak -->
        <LinearLayout
            android:id="@+id/row_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flame"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="13sp"
                android:textColor="@color/color_accent" />

        </LinearLayout>

        <!-- Hero Card: Next Canonical Hour -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_next_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gold"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_canonical_hour_label"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/color_accent"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_next_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="serif"
                    android:textSize="26sp"
                    android:textColor="@color/color_on_background" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/color_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/tap_to_begin_prayer"
                    android:textSize="13sp"
                    android:textColor="@color/color_text_secondary" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Canonical Hours Horizontal List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="24dp"
            android:text="@string/canonical_hours"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:textColor="@color/color_text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_prayer_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="20dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_anim_fall_down"
            android:orientation="horizontal" />

        <!-- Saint of the Day -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="24dp"
            android:text="@string/saint_of_day"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:textColor="@color/color_text_secondary" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_saint_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/color_card"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/color_divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_saint_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:textSize="20sp"
                    android:textColor="@color/color_on_background" />

                <TextView
                    android:id="@+id/tv_saint_feast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@color/color_accent" />

                <TextView
                    android:id="@+id/tv_saint_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/color_on_surface" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
