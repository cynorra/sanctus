<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Salutation & Rosary Fast Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting_morning"
                    android:fontFamily="@font/ebgaramond"
                    android:textSize="32sp"
                    android:textColor="@color/color_on_background" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/color_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_rosary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_streak_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tile_rosary_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_rosary"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tile_rosary_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="italic|bold"
                    android:textSize="13sp"
                    android:textColor="?attr/sanctusAccent"
                    android:text="@string/nav_rosary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="→"
                    android:textSize="11sp"
                    android:textColor="@color/color_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Canonical Liturgy of the Hours Card -->
        <LinearLayout
            android:id="@+id/card_next_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_glass_card">

            <LinearLayout
                android:id="@+id/row_next_hour_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/canonical_hours"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.16"
                    android:textSize="11sp"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textSize="10sp"
                    android:textColor="@color/color_stone_faint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_divine_office"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="italic"
                    android:textSize="12sp"
                    android:textColor="@color/color_text_secondary" />

                <ImageView
                    android:id="@+id/iv_expand_chevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@null" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_prayer_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <!-- Expandable full schedule -->
            <LinearLayout
                android:id="@+id/container_hours_expand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/color_glass_stroke" />

                <LinearLayout
                    android:id="@+id/list_hours_mini"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#0DFFFFFF" />

            <!-- Active Hour Preview Row -->
            <LinearLayout
                android:id="@+id/row_begin_prayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕯"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_next_hour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/ebgaramond"
                    android:textSize="15sp"
                    android:textColor="@color/color_on_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chant_hour"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/sanctusAccent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sacred Intentions (Mood Pill Selector) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sanctuary_mood_header"
                android:textAllCaps="true"
                android:letterSpacing="0.14"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_tap_to_pray"
                android:textSize="10.5sp"
                android:textColor="@color/color_stone_faint" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/row_mood_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mood_anxiety"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_streak_pill"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mood_anxiety"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mood_peace"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_sanctuary_tile_gold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mood_peace"
                    android:textColor="@color/color_gold_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mood_gratitude"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_streak_pill"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mood_gratitude"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mood_strength"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_streak_pill"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mood_strength"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mood_sleep"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_streak_pill"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mood_sleep"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Saint of the Day Spotlight Card -->
        <LinearLayout
            android:id="@+id/card_saint_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_saint_kicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/saint_of_day"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.18"
                    android:textSize="10.5sp"
                    android:textColor="?attr/sanctusAccent" />

                <TextView
                    android:id="@+id/tv_saint_feast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="italic"
                    android:textSize="12sp"
                    android:textColor="@color/color_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/tv_saint_initial"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:background="@drawable/bg_tile_selected"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="?attr/sanctusAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_saint_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/ebgaramond"
                            android:textStyle="bold"
                            android:textSize="19sp"
                            android:textColor="@color/color_on_background" />

                        <ImageButton
                            android:id="@+id/btn_share_saint_of_day"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_share"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="@color/color_text_secondary"
                            android:contentDescription="@string/share_action" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_saint_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/ebgaramond"
                        android:lineSpacingMultiplier="1.35"
                        android:textSize="14.5sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Warm Antique Parchment Card: Prayer / Verse of the Day -->
        <LinearLayout
            android:id="@+id/card_prayer_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_parchment_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prayer_of_day"
                    android:fontFamily="@font/ebgaramond"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2"
                    android:textSize="10.5sp"
                    android:textColor="@color/color_stone_faint" />

                <ImageButton
                    android:id="@+id/btn_share_prayer_of_day"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/color_sepia_sub"
                    android:contentDescription="@string/share_action" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_prayer_of_day_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ebgaramond"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="@color/color_sepia_ink" />

            <TextView
                android:id="@+id/tv_prayer_of_day_excerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ebgaramond"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.35"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/color_sepia_sub" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/color_parchment_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☩"
                    android:fontFamily="@font/ebgaramond"
                    android:textSize="14sp"
                    android:textColor="@color/color_stone_faint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_read_chapter"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_sepia_ink" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3-Column Quiet Sanctuary Dock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_sanctuary_peace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_sanctuary_tile_gold"
                    android:text="🕯"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sanctuary_tile_peace"
                    android:textColor="@color/color_on_background"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sanctuary_tile_peace_sub"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_sanctuary_journal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_streak_pill"
                    android:text="📖"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sanctuary_tile_journal"
                    android:textColor="@color/color_on_background"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sanctuary_tile_journal_sub"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_sanctuary_plans"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_streak_pill"
                    android:text="✨"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sanctuary_tile_plans"
                    android:textColor="@color/color_on_background"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sanctuary_tile_plans_sub"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Link to All Prayers -->
        <LinearLayout
            android:id="@+id/tile_prayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☧"
                android:fontFamily="@font/ebgaramond"
                android:textSize="18sp"
                android:textColor="?attr/sanctusAccent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/nav_prayers"
                android:fontFamily="@font/ebgaramond"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textSize="14sp"
                android:textColor="?attr/sanctusAccent" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
