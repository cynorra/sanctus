<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jesus_prayer_title"
            android:textAppearance="@style/TextAppearance.Sanctus.HeadlineLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/jesus_prayer_tap"
            android:textAppearance="@style/TextAppearance.Sanctus.Eyebrow"
            android:textAllCaps="true" />

        <!-- Tap anywhere inside the ring to count one prayer. -->
        <FrameLayout
            android:id="@+id/jesus_touch"
            android:layout_width="284dp"
            android:layout_height="284dp"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/jesus_prayer_tap">

            <View
                android:id="@+id/jesus_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="18dp"
                android:background="@drawable/bg_orb_gold" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/jesus_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                app:indicatorColor="?attr/sanctusAccent"
                app:indicatorSize="270dp"
                app:trackColor="@color/color_glass_stroke"
                app:trackCornerRadius="6dp"
                app:trackThickness="7dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cross"
                    app:tint="?attr/sanctusAccent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/jesus_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Sanctus.HeadlineLarge"
                    android:textColor="@color/color_on_background" />

                <TextView
                    android:id="@+id/jesus_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_glass_card"
            android:minHeight="110dp"
            android:padding="22dp">

            <TextView
                android:id="@+id/jesus_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/jesus_prayer_text"
                android:textAppearance="@style/TextAppearance.Sanctus.Prayer"
                android:textColor="@color/color_on_background" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jesus_again"
            style="@style/Widget.Sanctus.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/jesus_prayer_again"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
