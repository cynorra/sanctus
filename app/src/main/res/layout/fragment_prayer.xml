<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayers_title"
            android:fontFamily="serif"
            android:textSize="28sp"
            android:textColor="@color/color_on_background" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_search_prayers" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_gold" android:paddingHorizontal="16dp"
            android:hint="@string/search_prayers_hint" android:textSize="14sp"
            android:textColor="@color/color_on_surface"
            android:textColorHint="@color/color_text_secondary"
            android:inputType="text" android:imeOptions="actionSearch"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag=""
                android:text="@string/category_all"
                android:checked="true" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_morning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="morning"
                android:text="@string/category_morning" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_evening"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="evening"
                android:text="@string/category_evening" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="mass"
                android:text="@string/category_mass" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rosary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="rosary"
                android:text="@string/category_rosary" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_devotional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="devotional"
                android:text="@string/category_devotional" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/color_divider"/>

    <TextView
        android:id="@+id/tv_fallback_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:text="@string/no_prayers_in_language"
        android:textSize="12sp"
        android:textColor="@color/color_accent"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_prayers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tv_empty_prayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_results_found"
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
