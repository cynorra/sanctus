<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/color_surface"
    android:paddingHorizontal="8dp" android:paddingBottom="16dp" android:paddingTop="12dp">

    <View android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp"
        android:background="@color/color_divider"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingBottom="8dp"
        android:text="@string/share_sheet_title" android:fontFamily="serif"
        android:textSize="18sp" android:textColor="@color/color_on_background"/>

    <LinearLayout android:id="@+id/row_whatsapp" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_whatsapp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="WhatsApp"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_facebook" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_facebook"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="Facebook Gönderi"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_facebook_story" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_facebook"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="Facebook Hikaye"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_instagram" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_instagram"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="Instagram Gönderi"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_instagram_story" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_instagram"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="Instagram Hikaye"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_tiktok" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_tiktok"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="TikTok"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:layout_marginVertical="8dp" android:background="@color/color_divider"/>

    <LinearLayout android:id="@+id/row_more" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_more"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="@string/share_more_option"
            android:textSize="16sp" android:textColor="@color/color_on_surface"/>
    </LinearLayout>

</LinearLayout>
