    <string name="onboarding_title_1">Willkommen bei Sanctus</string>
    <string name="onboarding_desc_1">Ihr geistlicher Begleiter für das Stundengebet, den Rosenkranz, die Heiligen und den liturgischen Kalender.</string>
    <string name="onboarding_title_2">Kanonische Horen</string>
