    <string name="onboarding_desc_2">Nhận những lời nhắc nhở nhẹ nhàng cho cả sáu giờ kinh — Kinh Sáng, Kinh Giờ Ba, Kinh Giờ Sáu, Kinh Giờ Chín, Kinh Chiều và Kinh Tối.</string>
    <string name="onboarding_title_3">Kinh Mân Côi Thánh</string>
    <string name="onboarding_desc_3">Kinh Mân Côi có hướng dẫn với việc tự động chọn mầu nhiệm theo ngày trong tuần.</string>
