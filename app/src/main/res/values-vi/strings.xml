    <string name="onboarding_title_1">Chào Mừng Đến Với Sanctus</string>
    <string name="onboarding_desc_1">Người bạn đồng hành thánh thiện cho Kinh Nhật Tụng, Kinh Mân Côi, Các Thánh và Lịch Phụng Vụ.</string>
