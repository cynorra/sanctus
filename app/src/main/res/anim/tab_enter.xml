<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:fromAlpha="0" android:toAlpha="1"
        android:duration="320" android:startOffset="60"
        android:interpolator="@android:interpolator/decelerate_cubic"/>
    <translate android:fromYDelta="2.5%" android:toYDelta="0"
        android:duration="380" android:startOffset="60"
        android:interpolator="@android:interpolator/decelerate_quint"/>
    <scale android:fromXScale="0.985" android:toXScale="1"
        android:fromYScale="0.985" android:toYScale="1"
        android:pivotX="50%" android:pivotY="30%"
        android:duration="380" android:startOffset="60"
        android:interpolator="@android:interpolator/decelerate_quint"/>
</set>
