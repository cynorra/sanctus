<?xml version="1.0" encoding="utf-8"?>
<!-- Obsidian Sanctuary Backdrop with subtle ambient candlelight glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07090E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle" android:tint="?attr/sanctusGlow">
            <gradient
                android:type="radial"
                android:gradientRadius="65%p"
                android:centerX="0.92"
                android:centerY="0.04"
                android:startColor="#1EFFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle" android:tint="?attr/sanctusAccent">
            <gradient
                android:type="radial"
                android:gradientRadius="62%p"
                android:centerX="0.08"
                android:centerY="0.90"
                android:startColor="#1AFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>
