<?xml version="1.0" encoding="utf-8"?>
<!-- Screen backdrop: ink black with two soft glows (violet top-left, gold lower-right). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_background"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="75%p"
                android:centerX="0.1"
                android:centerY="0.0"
                android:startColor="?attr/sanctusGlowA38"
                android:endColor="?attr/sanctusGlowA00"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="1.0"
                android:centerY="0.95"
                android:startColor="?attr/sanctusAccentA1F"
                android:endColor="?attr/sanctusAccentA00"/>
        </shape>
    </item>
</layer-list>
