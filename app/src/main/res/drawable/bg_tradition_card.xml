<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/sanctusAccentA1F"/>
            <stroke android:width="1.5dp" android:color="?attr/sanctusAccent"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_glass_fill"/>
            <stroke android:width="1dp" android:color="@color/color_glass_stroke"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</selector>
