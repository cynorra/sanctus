    <string name="onboarding_title_1">Sanctus-க்கு வரவேற்கிறோம்</string>
    <string name="onboarding_desc_1">மணி நேர ஜெபம், ஜெபமாலை, புனிதர்கள் மற்றும் திருவழிபாட்டு நாட்காட்டிக்கான உங்கள் புனித தோழர்.</string>
    <string name="onboarding_title_2">நியமன மணி நேரங்கள்</string>
    <string name="onboarding_desc_2">ஆறு நியமன மணி நேரங்களுக்கும் மென்மையான நினைவூட்டல்களைப் பெறுங்கள் — காலைத் துதி, மூன்றாம் மணி, நண்பகல், பிற்பகல், மாலை ஜெபம் மற்றும் இரவுத் தொழுகை.</string>
    <string name="onboarding_title_3">திருவழிபாட்டு ஜெபமாலை</string>
    <string name="onboarding_desc_3">வார நாளின் அடிப்படையில் தானியங்கி மறை தேர்வுடன் வழிநடத்தப்படும் ஜெபமாலை.</string>
    <string name="onboarding_title_4">புனிதர்களும் நாட்காட்டியும்</string>
    <string name="onboarding_desc_4">இன்றைய புனிதரைக் கண்டறியுங்கள், விழாக்கள், பேரிழாக்கள் மற்றும் காலங்களுடன் கூடிய முழு திருவழிபாட்டு நாட்காட்டியையும் ஆராயுங்கள்.</string>
